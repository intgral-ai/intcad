{
  "name": "@intgral-ai/solidcraft-mastra-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone SolidCraft native workflow runtime speaking protocol 1.0 over stdio.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/src/main.js",
  "exports": {
    ".": "./dist/src/main.js",
    "./protocol": "./dist/src/protocol.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "DEPENDENCIES.md"
  ],
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "verify:schema": "node dist/src/bin/verify-schema.js",
    "check:deps": "node scripts/check-dependency-policy.mjs && node scripts/runtime-artifact.mjs --check",
    "check:artifact-approval": "node scripts/runtime-artifact.mjs --check --require-approved",
    "test:artifact-gate": "node scripts/test-runtime-artifact.mjs",
    "artifact:generate": "node scripts/runtime-artifact.mjs --generate",
    "artifact:check": "node scripts/runtime-artifact.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
