<?xml version="1.0" encoding="utf-8"?>
<!--
  SolidCraft MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build solidcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc solidcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d HasMastra=0|1 -d HasMastraAgent=0|1 -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\Intcad by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  SolidCraft" box. Installs a Start Menu shortcut, intcad-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), makes SolidCraft the owner of `.sc` (and of the older `.solidcraft` and pre-rename `.solvecraft`), and offers it under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install that
       carries it. It is Intcad's own, not upstream SolidCraft's, so neither product's installer
       replaces the other (docs/compatibility.md). -->
  <Package
      Name="Intcad"
      Manufacturer="Intgral"
      Version="$(var.Version)"
      UpgradeCode="984E28EB-86EB-46BE-908D-738A48FE6432"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Intcad parametric 3D CAD" Manufacturer="Intgral" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Intcad is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="SolidcraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SolidcraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://intgral-ai.github.io/intcad-releases/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/intgral-ai/intcad-releases/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/intgral-ai/intcad-releases/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Intcad" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by SolidcraftApp). -->
    <!-- Since the rename the folder and this key say SolidCraft. A pre-rename install recorded
         Software\SolveCraft, which isn't read: its upgrade (same UpgradeCode) removes the old
         folder and installs into Program Files\Intcad (docs/compatibility.md). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Intcad" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Intcad" Level="1">
      <ComponentGroupRef Id="SolidcraftFiles" />
      <?if $(var.HasMastra) = 1 ?>
      <ComponentGroupRef Id="SolidcraftMastra" />
      <?endif?>
      <?if $(var.HasMastraAgent) = 1 ?>
      <ComponentGroupRef Id="SolidcraftMastraAgent" />
      <?endif?>
    </Feature>

    <!-- WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSolidcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="SolidcraftVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Intcad $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Intcad" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SolidcraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchSolidcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="SolidcraftFiles" Directory="INSTALLFOLDER">
      <!-- A GUID of Intcad's own, for the key file intcad.exe in Intcad's folder. No install of
           upstream SolidCraft, and none of Intcad 0.1.0, carries it. -->
      <Component Id="SolidcraftApp" Guid="52EE9723-50D7-463A-8F4B-4551B5D33517">
        <File Id="SolidcraftExe" Source="$(var.BinDir)\intcad.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Intcad"
              Description="Intcad parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SolidcraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .sc: SolidCraft's own format; SolidCraft is its default app. -->
        <ProgId Id="Intcad.Design" Description="Intcad Design" Icon="SolidcraftExe" IconIndex="0">
          <Extension Id="sc" ContentType="application/x-solidcraft">
            <Verb Id="open" Command="Open" TargetFile="SolidcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved as .solidcraft (before .sc)
             and as .solvecraft (before the rename) open as the same ProgId. Registered by hand: a
             second Extension under one ProgId would write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft" Value="Intcad.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft" Name="Content Type" Value="application/x-solidcraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Value="Intcad.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Name="Content Type" Value="application/x-solvecraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="Intcad.Model" Description="3D model" Icon="SolidcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Intcad.Model\shell\open\command" Value="&quot;[#SolidcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="Intcad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="Intcad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="Intcad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="Intcad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="Intcad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="Intcad.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "intcad"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe" Name="FriendlyAppName" Value="Intcad" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\shell\open\command" Value="&quot;[#SolidcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".solidcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\intcad.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\intcad.exe" Value="[#SolidcraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Intcad" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SolidcraftCli">
        <File Id="SolidcraftCliExe" Source="$(var.BinDir)\intcad-cli.exe" KeyPath="yes" />
        <!-- The install folder on the system PATH, so MCP clients and shells find `intcad-cli` by name;
             removed again on uninstall. -->
        <Environment Id="SolidcraftPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="SolidcraftLicences" Guid="2BC0E79E-2792-4849-B0BC-B8AB82D403EA">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
      <!-- The third-party notices of the Assistant's page (packages/assistant-web). A component
           of its own: the one above keeps the files it has always had. -->
      <Component Id="AssistantPageNotices">
        <File Id="AssistantNotices" Source="$(var.BinDir)\ASSISTANT-THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
      </Component>
      <!-- The web view platform's licences (GTK/WebKitGTK, WebView2, WKWebView), including the
           LGPL text; also built into Help > About > Licences. -->
      <Component Id="WebViewPlatformNotices">
        <File Id="WebViewNotices" Source="$(var.BinDir)\WEB-VIEW-PLATFORM-NOTICES.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    The application-relative Mastra runtime (mastra\runtime.json, node.exe, dist\, node_modules\,
    contract bundle and licences). Only Windows x86_64 MSVC builds stage it. Harvested as a
    directory tree so every production dependency and the pinned Node executable is installed;
    omitting any file would make the host reject the runtime as incomplete before a turn.
  -->
  <?if $(var.HasMastra) = 1 ?>
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="MastraFolder" Name="mastra" />
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="SolidcraftMastra" Directory="MastraFolder">
      <Files Include="$(var.BinDir)\mastra\**" />
    </ComponentGroup>
  </Fragment>
  <?endif?>

  <!--
    The built-in agent's folder (mastra-agent\: node.exe, agent\main.mjs, node_modules\ and the
    licence texts), in test packages built with -WithMastraAgent. Harvested as a directory tree:
    the app offers the agent only when node.exe, the entry and the SDK are all there.
  -->
  <?if $(var.HasMastraAgent) = 1 ?>
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="MastraAgentFolder" Name="mastra-agent" />
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="SolidcraftMastraAgent" Directory="MastraAgentFolder">
      <Files Include="$(var.BinDir)\mastra-agent\**" />
    </ComponentGroup>
  </Fragment>
  <?endif?>
</Wix>
